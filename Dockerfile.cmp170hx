# Derived runtime: lazymio/vllm-backport:v0.13.0-sm80 (prebuilt sm80 wheel, built
# from origin/master at tag v0.13.0) + this checkout's vllm/ PYTHON tree overlaid
# wholesale + the deployment files.
#
# Two v0.13 derivations existed and were merged on 2026-09-12:
#   - this line (overlay): the python tree is overlaid wholesale, because the
#     production checkpoint needs hunks the base image does not carry:
#       qwen3_5.py / qwen3_5_mtp.py  embed-quant (eq8emb checkpoints need
#                                    quant_config on VocabParallelEmbedding)
#       qwen3_dflash.py              vllm#51620, DFlash with a quantized drafter
#     Plus #45015, the marlin int8 set and the csrc traps (#48375 was removed here).
#   - karl/cmp170hx-v013 (no overlay, merged in here): base
#     lazymio/vllm-backport:latest-sm80 (v0.13.0, upstream 93911fcf68) used AS IS
#     with a deployment-only overlay, its tree pinned by hash + text assertions.
#     That line requires these to be carried upstream (verified 2026-09-11
#     against origin/master a350766628; assertions for them are kept below):
#       PR #63 PP+MTP+prefix-cache mamba state corruption (mamba_utils copy
#         kernels index the SOURCE req-indexed tables by req_idx; runner binds
#         ctx to those tables in preprocess_state)
#       vllm#53142 state-seed divisor = mamba group block size
#       #55223 reasoning-end offset scan (v1/structured_output + parser/)
#       GLM PP mHC hand-off + MTP draft embed-from-checkpoint
#       Qwen UVA PLE pinned-host offload (replaces PleOffloadWorker; the
#         VLLM_PP_LAYER_PARTITION clear patch is obsolete: no offload subprocess)
#     It cannot serve our eq8emb checkpoint: with no python overlay, load dies
#     with "no parameter named 'embed_tokens.weight_packed'". The overlay is a
#     load requirement on this box, not a preference.
#
# Resolved 2026-09-12 (was an open disagreement between the two lines):
#   - vllm#48375 MambaManager extra block drop: REMOVED here (the no-overlay line's
#     position was right). Upstream get_replay_boundaries (#53945/#54713) already
#     retains the checkpoint at the post-drop candidate; the extra drop zeroed
#     resends, and with spec decode + CUDA graphs + a prefix-cache hit it faulted
#     the GPU (Xid 31 MMU fault). The assertion below now requires it to be absent.
#   - #45015 PP bitmask drain: this line keeps it (scheduler hook + engine drain,
#     asserted below). The no-overlay line dropped it because the 0.13 port rewired
#     structured output to a placeholder design under async scheduling; re-evaluate
#     against live traffic -- the orchestrator's request-level 502 guard is the
#     standing safety net.
#
# Only vllm/**.py is overlaid; the compiled _C.abi3.so comes from the base, so
# csrc/ changes carried by this branch (the fail-fast alignment traps) are NOT in
# this image -- those need a source build. The Python tree is version-checked
# against the base below (BASE DRIFT guard).
FROM dockerproxy.net/lazymio/vllm-backport:v0.13.0-sm80

# Pin the base to the exact tree this branch was verified against.
COPY vllm/__init__.py /tmp/vllm_tree_check/__init__.py
RUN python3 -c "import vllm,os,sys,hashlib;q=os.path.dirname(vllm.__file__);\
d=hashlib.md5(open('/tmp/vllm_tree_check/__init__.py','rb').read()).hexdigest();\
i=hashlib.md5(open(os.path.join(q,'__init__.py'),'rb').read()).hexdigest();\
sys.exit(0 if d==i else (sys.stderr.write(f'BASE DRIFT {d} != {i}\n') or 1))"

# Wholesale Python overlay (base verified identical to fb4a3d9; branch adds
# PR#44 + GLM PP handoff + MTP embed-from-checkpoint + Qwen PLE PP unlocks +
# the embed-quant / qwen3_dflash hunks).
COPY vllm/ /usr/local/lib/python3.12/dist-packages/vllm/

# Deployment layer, kept from the merged no-overlay line: launchers + bench for
# boxes that run the image directly. The kk-x99 worker still bind-mounts its own
# launcher per file (see launch-27b-kkx99.sh), which wins over this copy.
COPY launch-dsv4.sh launch-glm.sh launch-qwen.sh fetch-glm-awq.sh \
     verify_correctness.sh /opt/cmp17hx/
COPY bench/ /opt/cmp17hx/bench/
RUN chmod +x /opt/cmp17hx/*.sh /opt/cmp17hx/bench/*.py 2>/dev/null || true

RUN python3 - <<'EOF'
import importlib, os, sys
root = os.path.dirname(importlib.import_module("vllm").__file__)
read = lambda *p: open(os.path.join(root, *p)).read()
mods = [
    "vllm.models.glm5next.nvidia.model",
    "vllm.models.qwen4_exp.nvidia.model_state",
    "vllm.models.qwen4_exp.nvidia.ngram_embedding",
    "vllm.v1.worker.gpu.spec_decode.eagle.utils",
    "vllm.v1.core.sched.async_scheduler",
]
# importlib-only checks (no CUDA); model modules pull config/nn deps fine
for m in mods:
    importlib.import_module(m)
import vllm.v1.worker.gpu.spec_decode.eagle.utils as u
assert hasattr(u, "_load_embed_from_checkpoint"), "MTP embed fix missing"
import vllm.models.glm5next.nvidia.model as gm
assert hasattr(gm.Glm5NextModel, "make_empty_intermediate_tensors"), "PP handoff missing"
# PP + MTP + prefix-caching state-corruption fix ('duct' loops / all-NaN
# logits): the mamba spec-decode copy kernels must index the SOURCE req-indexed
# block tables by req_idx, and the V2 runner must bind the ctx to those source
# tables rather than the per-step gathered views. Text checks (not inspect)
# because the kernels are triton JIT objects.
mu = read("v1", "worker", "mamba_utils.py")
assert "bt_row_idx = req_idx" in mu, "mamba postprocess still indexes batch rows"
assert "HAS_IDX_MAPPING else req_idx" not in mu, "stale batch-row indexing is back"
assert "req_idx,\n        src_col," in mu, "mamba precopy still indexes batch rows"
mr = read("v1", "worker", "gpu", "model_runner.py")
assert "tuple(bt.gpu for bt in self.block_tables.block_tables)" in mr, (
    "mamba ctx not bound to source block tables"
)
# vllm#48375's extra block drop must NOT be present (see the header: it zeroed
# resends on this base -- with spec decode + graphs + a prefix-cache hit it faulted
# the GPU on 2026-09-12).
sm = read("v1", "core", "single_type_kv_cache_manager.py")
assert "max_length = max(0, max_length - kv_cache_spec.block_size)" not in sm, (
    "re-ported #48375 extra block drop (mamba state zeroed on prefix-cache resends)"
)
# vllm#53142 (no upstream PR): state-seed divisor = mamba group block size.
# (v0.13.0 carries the same fix as `// self._mamba_block_size`.)
mh = read("v1", "worker", "gpu", "model_states", "mamba_hybrid.py")
assert "// self._mamba_block_size" in mh, "mamba state seed uses CLI block size divisor"
# 09-10 xgrammar FSM desync ports. #55223 (upstream main 09-08): reasoning-end
# detection must use the offset scan, not the old per-token full-history sim.
so = read("v1", "structured_output", "__init__.py")
assert "find_reasoning_end_offset" in so, "#55223 reasoning-offset scan missing"
# #45015 (upstream PR, open): deferred bitmask must drain in-flight batches
# until structured FSMs catch up, else PP+async samples from a stale FSM.
# (Contested: see the header.)
sc = read("v1", "core", "sched", "scheduler.py")
ec = read("v1", "engine", "core.py")
assert "def has_structured_output_in_flight" in sc, "#45015 scheduler hook missing"
assert "has_structured_output_in_flight(" in ec, "#45015 bitmask drain missing"
# GLM PP mHC hand-off + MTP draft embed-from-checkpoint, as the no-overlay line
# verified against its base (kept here as a tripwire for the same upstreams).
gmp = read("models", "glm5next", "nvidia", "model.py")
assert "mHC" in gmp or "mhc" in gmp, "GLM PP mHC hand-off missing"
ne = read("models", "qwen4_exp", "nvidia", "ngram_embedding.py")
assert "Qwen4ExpPLEPinnedHostEmbedding" in ne, "UVA PLE offload missing"
assert "is_uva_available" in ne, "UVA guard missing"
# syv-ai's marlin set (int8 tensor-core GEMMs on Ampere): per-layer int8 activation
# selection, negative-scale handling, staged sm80 repack, and the tune table.
assert "VLLM_MARLIN_INT8_INCLUDE_RE" in read("envs.py"), "marlin int8 layer select missing"
_mk = read("model_executor", "kernels", "linear", "mixed_precision", "marlin.py")
assert "_use_staged_repack" in _mk, "staged sm80 repack missing"
assert "_load_marlin_tune" in _mk, "marlin tune table missing"
_mu = read("model_executor", "layers", "quantization", "utils", "marlin_utils.py")
assert "VLLM_MARLIN_INT8_EXCLUDE_RE" in _mu, "marlin int8 include/exclude missing"
print("overlay assertions OK")
EOF
