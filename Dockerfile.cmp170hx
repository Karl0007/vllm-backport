# Derived runtime: lazymio/vllm-backport:latest-sm80 (v0.13.0, upstream
# 93911fcf68 port line, LMCache fork bundled) + the cmp170hx-v013 deployment
# layer. The branch now carries local Python patches, so the overlay copies
# those files over the base tree (see "patched locally" below); everything
# else is used AS IS. Assertions pin the fixes this line must contain
# (verified at port time, 2026-09-11, origin/master a350766628):
#
# carried upstream (no local patch needed):
#   - PR #63 PP+MTP+prefix-cache mamba state corruption: align copy kernels
#     index rows by req_idx (mamba_utils.py) + runner binds ctx to the SOURCE
#     req-indexed tables (gpu/model_runner.py preprocess_state)
#   - #55223 reasoning-end offset scan (v1/structured_output + parser/)
#   - GLM PP mHC hand-off + MTP embed-from-checkpoint (d09b08caf5)
#   - Qwen UVA PLE pinned-host offload (replaces PleOffloadWorker; the
#     VLLM_PP_LAYER_PARTITION clear patch is obsolete: no offload subprocess)
# patched locally (overlay below):
#   - mamba_hybrid.py align-mode state column divisor. The port checklist
#     assumed upstream carried the vllm#53142 seed fix because the file cites
#     that issue; it does not. Upstream divides by
#     `cache_config.mamba_block_size or cache_config.block_size`, which on a
#     hybrid engine is smaller than the mamba group's aligned page (16 vs 4480
#     here), so a prefix-cache resume seeded a column up to 280x too large --
#     outside the block-table row -- and the align pre-copy read a garbage
#     block id (Xid 13). The v0.11.2 line fixed this in 1cdd6bc316.
#   - flash_linear_attention/ops/index.py: derive per-step chunk metadata on
#     every call instead of caching it by tensor identity.
# deliberately NOT re-ported:
#   - #45015 PP bitmask drain: the 0.13 port rewired structured output under
#     async scheduling to a placeholder design (pending_structured_output_tokens
#     + num_output_placeholders, async_scheduler.py); the drain hook no longer
#     applies. Re-evaluate against live traffic; orchestrator http_api.py
#     request-level 502 guard (commit a9a1189) is the standing safety net.
#   - vllm#48375 MambaManager extra block drop: upstream get_replay_boundaries
#     (#53945/#54713) retains the checkpoint at the post-drop candidate; the
#     extra drop zeroed resends (a47f0f82d5).
FROM dockerproxy.net/lazymio/vllm-backport:latest-sm80

# Pin the base to the exact tree this branch was verified against.
COPY vllm/__init__.py /tmp/vllm_tree_check/__init__.py
RUN python3 -c "import vllm,os,sys,hashlib;q=os.path.dirname(vllm.__file__);\
d=hashlib.md5(open('/tmp/vllm_tree_check/__init__.py','rb').read()).hexdigest();\
i=hashlib.md5(open(os.path.join(q,'__init__.py'),'rb').read()).hexdigest();\
sys.exit(0 if d==i else (sys.stderr.write(f'BASE DRIFT {d} != {i}\n') or 1))"

# Local vllm/ patches (this line is no longer upstream-identical). Run from a
# copied script, not an inline heredoc: this builder does not expand heredocs,
# so `RUN python3 - <<'EOF'` silently runs nothing and reports success.
COPY vllm/v1/worker/gpu/model_states/mamba_hybrid.py /tmp/vllm_patch/mamba_hybrid.py
COPY vllm/third_party/flash_linear_attention/ops/index.py /tmp/vllm_patch/fla_index.py
COPY deploy/apply-vllm-patches.py /tmp/vllm_patch/apply-vllm-patches.py
RUN python3 /tmp/vllm_patch/apply-vllm-patches.py /tmp/vllm_patch

# Deployment layer.
COPY launch-dsv4.sh launch-glm.sh launch-qwen.sh fetch-glm-awq.sh \
     verify_correctness.sh /opt/cmp17hx/
COPY bench/ /opt/cmp17hx/bench/
RUN chmod +x /opt/cmp17hx/*.sh /opt/cmp17hx/bench/*.py 2>/dev/null || true

COPY deploy/verify-vllm-tree.py /tmp/vllm_patch/verify-vllm-tree.py
RUN python3 /tmp/vllm_patch/verify-vllm-tree.py
