# Derived runtime: lazymio/vllm-backport:latest-sm80 (v0.13.0, upstream
# 93911fcf68 port line, LMCache fork bundled) + the cmp170hx-v013 deployment
# layer. The branch now carries local Python patches, so the overlay copies
# those files over the base tree (see "patched locally" below); everything
# else is used AS IS. Assertions pin the fixes this line must contain
# (verified at port time, 2026-09-11, origin/master a350766628):
#
# checklist below was re-derived on 2026-09-12 by auditing every commit the
# v0.11 line carries (git log origin/master..cmp170hx, 22 commits) against this
# tree; each one is carried, upstream-carried, deliberately dropped, or listed
# as a known gap. Keep it that way: the previous checklist claimed the
# align-mode seed divisor was upstream-carried because the file cites
# vllm#53142, and that single wrong entry cost a production-line Xid 13.
#
# known gap (deliberately not carried on this line):
#   - csrc/libtorch_stable alignment traps on raw float4/float2 casts
#     (083b4aeab2, on the compile line only). This image is a prebuilt sm80
#     wheel plus a pure-Python overlay, so csrc/ C++ is never compiled here and
#     carrying the diff would change nothing. Trigger to revisit: a misaligned
#     address Xid 13 reappearing on this line.

# known gap (deliberately not carried on this line):
#   - csrc/libtorch_stable alignment traps on raw float4/float2 casts
#     (083b4aeab2, compile line only). This image is a prebuilt sm80 wheel plus a
#     pure-Python overlay, so csrc/ C++ is never compiled here and carrying the diff
#     would change nothing. Trigger to revisit: a misaligned-address Xid 13
#     reappearing on this line.
#
# deliberately not re-ported as code (kept as a note only):
#   - vllm#48375 extra KV-cache block drop. It was carried on the x99 line until
#     2026-09-12 and then removed: on this base upstream's get_replay_boundaries
#     (#53945/#54713) already retains the checkpoint at the post-drop candidate, so
#     the extra drop zeroed resends -- a prefix-cache resend became a zero-token hit.
#     Symptom when carried: with speculative decoding, CUDA graphs and a prefix-cache
#     hit, the resumed mamba/GDN state pointed the verify attention outside every live
#     buffer and faulted the GPU (Xid 31, ~1227 blocks below the KV cache base).
#     Nothing to patch here: the fix is the *absence* of that block drop.
#
# env switches introduced by the split-KV port (all default off):
#   - VLLM_SPEC_DECODE_ATTN=1        enable the split-KV verify kernel on the FA2
#                                    backend (default "0"; profile sets SPEC_ATTN=1)
#   - VLLM_SPEC_DECODE_ATTN_QMAX=N   cap query tokens per request (default 0 = derive
#                                    from the model's spec config)
#   Cost note: the split-KV hook is +12% decode on the FA2 path (117.5 vs 105.0
#   aggregate, decode3). The short-context -26% seen on x99 comes from the fp8 KV
#   profile switching the backend to FlashInfer (97.6), NOT from this hook.

# carried upstream (no local patch needed):
#   - PR #63 PP+MTP+prefix-cache mamba state corruption: align copy kernels
#     index rows by req_idx (mamba_utils.py) + runner binds ctx to the SOURCE
#     req-indexed tables (mamba_hybrid.py _ensure_align_ctx)
#   - #55223 reasoning-end offset scan (v1/structured_output + parser/)
#   - GLM PP mHC hand-off + MTP draft embedding (upstream d09b08caf5 ported the
#     fork deltas; the drafter now shares/loads its embedding via
#     eagle/utils.py maybe_share_target_embed instead of the old
#     load-from-checkpoint helper)
#   - Qwen UVA PLE pinned-host offload (replaces PleOffloadWorker; the
#     VLLM_PP_LAYER_PARTITION clear patch is obsolete: no offload subprocess)
# patched locally (overlay below):
#   - mamba_hybrid.py align-mode state column divisor. Upstream divides by
#     `cache_config.mamba_block_size or cache_config.block_size`, which on a
#     hybrid engine is smaller than the mamba group's aligned page (16 vs 4480
#     here), so a prefix-cache resume seeded a column up to 280x too large --
#     outside the block-table row -- and the align pre-copy read a garbage
#     block id (Xid 13). The v0.11 line fixed this in 1cdd6bc316.
#   - flash_linear_attention/ops/index.py: derive per-step chunk metadata on
#     every call instead of caching it by tensor identity.
#   - ngram_embedding.py: byte-view the FP8 PLE table for the UVA lookup
#     kernel (upstream #56362, unmerged as of 2026-09-14). Without it the
#     engine dies in profile_run on SM8x -- Triton refuses an fp8e4nv pointer
#     below SM89 -- which is how Qwen3.8-Flash-Next-FP8 (e4m3 PLE table) could
#     not start on this line at all.
#   - v1/core/kv_cache_utils.py: skip other ranks' layers when a PP rank's KV
#     cache group projects to empty (upstream #54793/#54711, unmerged as of
#     2026-09-14). Without it Qwen3.8 (hybrid GDN+attention, PP 13,13,13,9)
#     dies with a bare StopIteration in allocate_kv_cache: ranks that own only
#     GDN layers keep the global spec dict of the empty attention group.
#   - v1/core/kv_cache_utils.py: annotate the MTP draft KV group positionally
#     for every MTP model, not only deepseek_v4 (upstream #55390, unmerged as
#     of 2026-09-14). Without it Qwen3.8's groups all fall back to
#     "draft group", and a Mamba group cannot satisfy the widened lookup
#     window -- align-mode checkpointing never produces it -- so cross-request
#     prefix-cache reuse is silently disabled for the GDN path (measured: an
#     identical 294k prompt still needed a full cold prefill).
# known gap, not carried (revisit trigger in the entry):
#   - csrc alignment traps (v0.11 083b4aeab2): __trap() guards on the raw
#     float4/float2 casts in csrc/libtorch_stable/{cache_kernels.cu,
#     persistent_topk.cuh}. They are C++ and cannot ride the Python overlay --
#     carrying them means rebuilding _C_stable_libtorch.abi3.so. Value: turns
#     a misaligned-access Xid 13 into a named kernel error, which is the only
#     in-process localization we have on this part (no compute-sanitizer).
#     Revisit if any misaligned-address Xid appears on this line.
# deliberately NOT re-ported:
#   - #45015 PP bitmask drain: the 0.13 port rewired structured output under
#     async scheduling to a placeholder design (pending_structured_output_tokens
#     + num_output_placeholders, async_scheduler.py); the drain hook no longer
#     applies. Re-evaluate against live traffic; orchestrator http_api.py
#     request-level 502 guard (commit a9a1189) is the standing safety net.
#   - vllm#48375 MambaManager extra block drop: upstream get_replay_boundaries
#     (#53945/#54713) retains the checkpoint at the post-drop candidate; the
#     extra drop zeroed resends (a47f0f82d5).

FROM dockerproxy.net/lazymio/vllm-backport:latest-sm80

# Pin the base to the exact tree this branch was verified against.
COPY vllm/__init__.py /tmp/vllm_tree_check/__init__.py
RUN python3 -c "import vllm,os,sys,hashlib;q=os.path.dirname(vllm.__file__);\
d=hashlib.md5(open('/tmp/vllm_tree_check/__init__.py','rb').read()).hexdigest();\
i=hashlib.md5(open(os.path.join(q,'__init__.py'),'rb').read()).hexdigest();\
sys.exit(0 if d==i else (sys.stderr.write(f'BASE DRIFT {d} != {i}\n') or 1))"

# Local vllm/ patches (this line is no longer upstream-identical). Run from a
# copied script, not an inline heredoc: this builder does not expand heredocs,
# so `RUN python3 - <<'EOF'` silently runs nothing and reports success.
COPY vllm/v1/worker/gpu/model_states/mamba_hybrid.py /tmp/vllm_patch/mamba_hybrid.py
COPY vllm/third_party/flash_linear_attention/ops/index.py /tmp/vllm_patch/fla_index.py
# Byte-views the PLE UVA lookup for FP8 tables (upstream #56362, unmerged):
# without it the engine dies in profile_run on SM8x (Triton rejects fp8e4nv).
COPY vllm/models/qwen4_exp/nvidia/ngram_embedding.py /tmp/vllm_patch/ngram_embedding.py
# Skips other ranks' layers when a PP rank's KV cache group projects empty
# (upstream #54793, unmerged): without it hybrid PP dies with a bare
# StopIteration in allocate_kv_cache during KV init.
COPY vllm/v1/core/kv_cache_utils.py /tmp/vllm_patch/kv_cache_utils.py
# split-KV spec-decode port (x99 line): one COPY per registered file, stage name
# prefixed to avoid basename collisions in the flat stage dir.
COPY vllm/v1/attention/ops/spec_decode_attn.py /tmp/vllm_patch/spec_decode_attn.py
COPY vllm/v1/attention/backends/flash_attn.py /tmp/vllm_patch/flash_attn_be.py
COPY vllm/v1/attention/backends/flashinfer.py /tmp/vllm_patch/flashinfer_be.py
COPY vllm/v1/engine/core.py /tmp/vllm_patch/engine_core.py
COPY vllm/v1/core/sched/interface.py /tmp/vllm_patch/sched_interface.py
COPY vllm/v1/core/sched/scheduler.py /tmp/vllm_patch/sched_scheduler.py
COPY vllm/v1/worker/gpu/spec_decode/eagle/utils.py /tmp/vllm_patch/eagle_utils.py
COPY vllm/v1/sample/rejection_sampler.py /tmp/vllm_patch/reject_sampler.py
COPY vllm/v1/worker/gpu/warmup.py /tmp/vllm_patch/warmup.py
COPY vllm/model_executor/models/qwen3_dflash.py /tmp/vllm_patch/qwen_dflash.py
COPY vllm/model_executor/layers/mamba/gdn/qwen_gdn_linear_attn.py /tmp/vllm_patch/qwen_gdn_attn.py
COPY vllm/model_executor/models/qwen3_5.py /tmp/vllm_patch/qwen3_5.py
COPY vllm/model_executor/models/qwen3_5_mtp.py /tmp/vllm_patch/qwen3_5_mtp.py
COPY deploy/apply-vllm-patches.py /tmp/vllm_patch/apply-vllm-patches.py
RUN python3 /tmp/vllm_patch/apply-vllm-patches.py /tmp/vllm_patch

# Deployment layer.
COPY launch-dsv4.sh launch-glm.sh launch-qwen.sh fetch-glm-awq.sh \
     verify_correctness.sh /opt/cmp17hx/
COPY bench/ /opt/cmp17hx/bench/
RUN chmod +x /opt/cmp17hx/*.sh /opt/cmp17hx/bench/*.py 2>/dev/null || true

COPY deploy/verify-vllm-tree.py /tmp/vllm_patch/verify-vllm-tree.py
RUN python3 /tmp/vllm_patch/verify-vllm-tree.py
